{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "model_recommender",
            "tool": "recommend_for_prompt",
            "input": {
              "prompt": "${prompt}",
              "session_id": "${session_id}",
              "model": "${model}"
            },
            "timeout": 60,
            "statusMessage": "Checking model and reasoning recommendations"
          }
        ]
      }
    ]
  }
}
