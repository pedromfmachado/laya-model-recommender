{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "model_recommender",
            "tool": "recommend_for_prompt",
            "input": {
              "prompt": "${prompt}",
              "session_id": "${session_id}",
              "model": "${model}",
              "turn_id": "${turn_id}",
              "transcript_path": "${transcript_path}"
            },
            "timeout": 60,
            "statusMessage": "Recommending a model for this task"
          }
        ]
      }
    ]
  }
}
